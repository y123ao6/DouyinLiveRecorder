    {
      "id": "scheduler",
      "label": "ConcurrencyScheduler",
      "kind": "component",
      "subtitle": "自适应并发容量 + 按平台熔断",
      "groupId": "engine-proc",
      "module": "record-engine",
      "facts": [
        "ResizableSemaphore 支持运行中动态收缩槽位",
        "PlatformBreaker 在某平台连续失败后熔断该域名",
        "并发槽必须在 Popen 之前 acquire，否则上限约束不到 ffmpeg 进程数"
      ],
      "source": {
