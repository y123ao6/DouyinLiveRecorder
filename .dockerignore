# =============================================================================
# DouyinLiveRecorder .dockerignore
# 支持抖音、TikTok、YouTube等60+平台直播录制工具
# =============================================================================

# ── Git ────────────────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.github/

# ── Docker 构建文件 ────────────────────────────────────────────────────────
.dockerignore
Dockerfile
docker-compose*.yaml
docker-compose*.yml

# ── 文档（不参与容器运行时）─────────────────────────────────────────────
README.md
LICENSE
CODE_WIKI.md
CODE_CHANGES.md
index.html

# ── 桌面/GUI 组件（容器为无头环境）──────────────────────────────────────
gui.py
StopRecording.vbs

# ── 开发/示例文件（非运行时必需）─────────────────────────────────────────
demo.py
ffmpeg_install.py

# ── Python 缓存 ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class

# ── 虚拟环境 ──────────────────────────────────────────────────────────────
.venv/
venv/
env/
.venv
env.bak/
venv.bak/

# ── 包管理与分发 ──────────────────────────────────────────────────────────
build/
dist/
*.egg-info/
.eggs/
uv.lock
poetry.lock
.pdm.toml
__pypackages__/

# ── Node.js 运行时（容器内通过 apt 安装）────────────────────────────────
node/
node-v*.zip

# ── FFmpeg 二进制文件（容器内通过 apt 安装）──────────────────────────────
ffmpeg/

# ── 测试与覆盖率 ──────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
.coverage.*
cover/
.hypothesis/

# ── 类型检查 ──────────────────────────────────────────────────────────────
.mypy_cache/
.pytype/
.pyre/

# ── IDE 和编辑器 ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.code-workspace
*.sublime-project
*.sublime-workspace

# ── 临时文件 ──────────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
*.swp
*.swo
*~

# ── 操作系统文件 ──────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini

# ── 项目专用：运行时目录（通过 docker-compose volumes 挂载）─────────────
downloads/
recordings/
logs/
*.log
*.log.*
backup_config/

# ── 项目专用：配置文件（通过 docker-compose volumes 挂载）───────────────
config/config.ini
config/URL_config.ini

# ── 编译的翻译文件（在构建过程中重新生成）────────────────────────────────
i18n/**/*.mo
i18n/**/compile_po.py

# ── Python 版本管理 ───────────────────────────────────────────────────────
.python-version

# ── 构建产物 ──────────────────────────────────────────────────────────────
*.manifest
*.spec
*.exe
*.dll
*.cmd
*.bat
*.vbs
*.desktop
*.lnk