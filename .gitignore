# =============================================================================
# DouyinLiveRecorder .gitignore
# 支持抖音、TikTok、YouTube等60+平台直播录制工具
# =============================================================================

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.py,cover
*.manifest
*.spec
*.sage.py

# ── 虚拟环境 ──────────────────────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ── 包管理与分发 ──────────────────────────────────────────────────────────
build/
dist/
*.egg-info/
.eggs/
eggs/
sdist/
wheels/
pip-log.txt
pip-delete-this-directory.txt
uv.lock
poetry.lock
.pdm.toml
__pypackages__/

# ── Node.js 运行时（Windows 本地自动下载）────────────────────────────────
node/
node-v*.zip

# ── FFmpeg 二进制文件 ──────────────────────────────────────────────────────
ffmpeg/*.exe
ffmpeg/*.dll
ffmpeg/ffmpeg
ffmpeg/ffprobe

# ── 测试与覆盖率 ──────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
.coverage.*
.cache
.xml
cover/
.hypothesis/

# ── 类型检查 ──────────────────────────────────────────────────────────────
.mypy_cache/
.pytype/
.pyre/

# ── 文档与网站 ────────────────────────────────────────────────────────────
docs/_build/
/site
index.html

# ── IDE 和编辑器 ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.code-workspace
*.sublime-project
*.sublime-workspace

# ── 操作系统文件 ──────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini

# ── Vim ────────────────────────────────────────────────────────────────────
*.swp
*.swo
*~

# ── 临时文件 ──────────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig

# ── 项目专用：运行时生成 ──────────────────────────────────────────────────
downloads/
recordings/
logs/
*.log
*.log.*

# ── 项目专用：备份 ────────────────────────────────────────────────────────
backup_config/

# ── 项目专用：文档（本地生成，非发行必需）────────────────────────────────
CODE_WIKI.md
CODE_CHANGES.md

# ── 项目专用：配置文件（包含敏感信息，需手动维护模板）──────────────────
# 注意: 若文件已被 git 追踪，需先执行 git rm --cached 使其生效
config/config.ini
config/URL_config.ini

# ── 编译的翻译文件（在构建过程中重新生成）────────────────────────────────
i18n/**/*.mo

# ── 项目专用：桌面快捷方式/入口文件（由构建工具生成）────────────────────
*.desktop
*.lnk